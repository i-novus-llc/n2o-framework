<?xml version='1.0' encoding='UTF-8'?>
<page xmlns="http://n2oapp.net/framework/config/schema/page-4.0">
    <datasources>
        <datasource id="formDS"/>
    </datasources>
    <regions>
        <form id="form" datasource="formDS">
            <toolbar>
                <button label="Выбрать" model="filter">
                    <show-modal page-id="modal" submit-action-type="copy" copy-model="multi" target-field-id="members" copy-mode="add" copy-datasource="tableDS" target-datasource="formDS"/>
                </button>
            </toolbar>
            <fields>
                <multi-set id="members" can-add="false">
                    <row>
                        <input-text id="id"/>
                        <input-text id="name"/>
                    </row>
                </multi-set>
            </fields>
        </form>
    </regions>
</page>