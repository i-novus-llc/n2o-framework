<?xml version='1.0' encoding='UTF-8'?>
<query xmlns="http://n2oapp.net/framework/config/schema/query-5.0">
    <unique>
        <test operation="echo"/>
    </unique>

    <filters>
        <eq field-id="age" filter-id="age"
            normalize="T(java.time.Period).between(T(java.time.LocalDateTime).parse(#this), T(java.time.LocalDate).now()).getYears()"/>
    </filters>

    <fields>
        <field id="result" mapping="['age'] >= 18"/>
        <field id="age"/>
    </fields>
</query>
