<?xml version='1.0' encoding='UTF-8'?>
<page xmlns="http://n2oapp.net/framework/config/schema/page-4.0" name="Модальная страница с прокинутыми значениями">
    <datasources>
        <datasource id="ds_modal"/>
        <parent-datasource id="ds"/>
    </datasources>
    <regions>
        <form>
            <fields>
                <hidden id="text">
                    <dependencies>
                        <set-value on="inputField" apply-on-init="false">inputField</set-value>
                    </dependencies>
                </hidden>
                <input-text id="inputField" label="Поле ввода, данные из которого должны отобразиться на странице"/>
            </fields>
        </form>
    </regions>
</page>
