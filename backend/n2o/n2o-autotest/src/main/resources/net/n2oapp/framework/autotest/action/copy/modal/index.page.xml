<?xml version='1.0' encoding='UTF-8'?>
<page xmlns="http://n2oapp.net/framework/config/schema/page-4.0">
    <datasources>
        <datasource id="formDS"/>
    </datasources>
    <regions>
        <form id="form" datasource="formDS">
            <toolbar>
                <button id="update" label="Открыть" model="filter">
