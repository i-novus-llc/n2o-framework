<?xml version='1.0' encoding='UTF-8'?>
<simple-page xmlns="http://n2oapp.net/framework/config/schema/page-4.0" name="Настраиваемое модальное окно">
    <form>
        <toolbar>
            <button label="Открыть с шапкой" model="filter">
                <show-modal page-id="test"/>
            </button>
            <button label="Открыть без шапки" model="filter">
                <show-modal page-id="test" backdrop="true" has-header="false"/>
            </button>
            <button label="backdrop='static'" no-label-block="true" disable-on-empty-model="false">
                <show-modal page-id="test" backdrop="static"/>
            </button>
            <button label="backdrop='false'" no-label-block="true" disable-on-empty-model="false">
                <show-modal page-id="test" backdrop="false"/>
            </button>
            <button label="backdrop='true'" no-label-block="true" disable-on-empty-model="false">
                <show-modal page-id="test" backdrop="true"/>
            </button>
        </toolbar>
    </form>
</simple-page>