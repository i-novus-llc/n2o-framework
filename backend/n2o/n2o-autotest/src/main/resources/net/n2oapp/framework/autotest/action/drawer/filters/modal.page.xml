<?xml version='1.0' encoding='UTF-8'?>
<page xmlns="http://n2oapp.net/framework/config/schema/page-4.0" name="Фильтры">
    <datasources>
        <parent-datasource id="ds1"/>
    </datasources>
    <regions>
        <form>
            <fields>
                <row>
                    <date-interval id="date" label="Дата подачи заявки" ref-datasource="ds1" ref-model="filter">
                        <default-value begin="{date.begin}" end="{date.end}"/>
                    </date-interval>
                </row>
                <select id="region" label="Регион" ref-datasource="ds1" ref-model="filter" query-id="region">
                    <default-value id="{region.id}" name="{region.name}"/>
                </select>
                <select id="department" label="Отделение" ref-datasource="ds1" ref-model="filter" query-id="department">
                    <default-value id="{department.id}" name="{department.name}"/>
                </select>
                <select id="status" label="Статус" ref-datasource="ds1" ref-model="filter" query-id="status">
                    <default-value id="{status.id}" name="{status.name}"/>
                </select>
                <set label="Заявитель">
                    <input-text id="fio" label="Фамилия Имя Отчество" default-value="{fio}" ref-datasource="ds1"
                                ref-model="filter"/>
                    <masked-input id="snils" label="СНИЛС" mask="999-999-999 99" default-value="{snils}" ref-datasource="ds1"
                                  ref-model="filter"/>
                </set>
            </fields>
        </form>
    </regions>
</page>