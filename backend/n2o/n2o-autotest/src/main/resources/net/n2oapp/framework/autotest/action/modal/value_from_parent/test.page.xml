<?xml version='1.0' encoding='UTF-8'?>
<page xmlns="http://n2oapp.net/framework/config/schema/page-4.0" name="Модальное окно">
    <datasources>
        <parent-datasource id="firstDs"/>
        <parent-datasource id="secondDs"/>
    </datasources>
    <regions>
        <form>
            <fields>
                <input-text id="name" label="Получение значения для простого поля по ссылке" ref-datasource="firstDs"
                            ref-field-id="name"/>
                <input-text id="name2" label="Получение значения для простого поля по default-value"
                            ref-datasource="firstDs"
                            default-value="{name}"/>
                <input-select id="address" label="Получение значения для спиского поля по default-value"
                              ref-datasource="firstDs"
                              query-id="test">
                    <default-value name="{address.name}" id="{address.id}"/>
                </input-select>
                <input-select id="addresses" label="Получение значения для спиского поля с множественным выбором"
                              ref-datasource="firstDs" ref-field-id="addresses" query-id="test" type="multi"/>
                <input-select id="addressByForm" label="Получение значения для спиского поля из модели всей формы"
                              ref-datasource="secondDs" query-id="test"/>
            </fields>
        </form>
    </regions>
</page>