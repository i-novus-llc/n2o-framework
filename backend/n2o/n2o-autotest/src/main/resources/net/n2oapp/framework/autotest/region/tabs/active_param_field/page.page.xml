<?xml version='1.0' encoding='UTF-8'?>
<page xmlns="http://n2oapp.net/framework/config/schema/page-4.0"
      name="Вкладки">
    <datasources>
        <datasource id="tabsDs"/>
    </datasources>

    <regions>
        <tabs datasource="tabsDs" active-param="param" active-tab-field-id="param">
            <tab id="tab1" name="ONE">
                <form>
                    <fields>
                        <input-text id="f1"/>
                    </fields>
                </form>
            </tab>

            <tab id="tab2" name="TWO">
                <form>
                    <fields>
                        <input-text id="f2"/>
                        <row>
                            <button id="toFirst" label="toFirst">
                                <set-value target-datasource="tabsDs" target-model="resolve" to="param">
                                    'tab1'
                                </set-value>
                            </button>
                            <button id="toThird" label="toThird">
                                <set-value target-datasource="tabsDs" target-model="resolve" to="param">
                                    'tab3'
                                </set-value>
                            </button>
                        </row>
                    </fields>
                </form>
            </tab>

            <tab id="tab3" name="THREE">
                <form>
                    <fields>
                        <input-text id="f3"/>
                    </fields>
                </form>
            </tab>
        </tabs>
    </regions>
</page>
