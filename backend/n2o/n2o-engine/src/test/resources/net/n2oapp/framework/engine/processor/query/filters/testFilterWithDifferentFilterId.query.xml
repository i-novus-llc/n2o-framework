<?xml version='1.0' encoding='UTF-8'?>
<query xmlns="http://n2oapp.net/framework/config/schema/query-5.0">
    <list filters="type_id">
        <test file="net/n2oapp/framework/engine/processor/query/filters/test.json" operation="findAll"/>
    </list>

    <filters>
        <eq field-id="type.id" filter-id="type_id"/>
    </filters>

    <fields>
        <field id="id" domain="integer"/>
        <field id="name"/>
        <reference id="type">
            <field id="id"/>
        </reference>
    </fields>
</query>