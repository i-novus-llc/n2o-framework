<?xml version='1.0' encoding='UTF-8'?>
<page xmlns="http://n2oapp.net/framework/config/schema/page-4.0">
    <regions>
        <panel>
            <table id="table">
                <columns>
                    <column visible="{abc == 1}" text-field-id=""/>
                    <column visible="true" text-field-id=""/>
                    <column text-field-id=""/>
                    <column text-field-id="visibilityTest">
                        <dependencies>
                            <visibility datasource="form" model="resolve">type == 1</visibility>
                        </dependencies>
                        <badge/>
                    </column>
                    <column text-field-id="visibilityTestFile">
                        <dependencies>
                            <visibility file="net/n2oapp/framework/config/metadata/compile/widgets/testVisibility.js"/>
                        </dependencies>
                    </column>
                    <multi-column id="multi1" label="Multi">
                        <column text-field-id="multiVisibilityTestFile">
                            <dependencies>
                                <visibility file="net/n2oapp/framework/config/metadata/compile/widgets/testVisibility.js"/>
                            </dependencies>
                        </column>
                    </multi-column>
                    <dnd-column>
                        <column text-field-id="dndVisibilityTestFile">
                            <dependencies>
                                <visibility file="net/n2oapp/framework/config/metadata/compile/widgets/testVisibility.js"/>
                            </dependencies>
                        </column>
                    </dnd-column>
                </columns>
            </table>
        </panel>
        <panel>
            <form id="form">
                <fields>
                    <input-text id="type"/>
                </fields>
            </form>
        </panel>
    </regions>
</page>