<?xml version='1.0' encoding='UTF-8'?>
<object xmlns="http://n2oapp.net/framework/config/schema/object-4.0">
    <operations>
        <operation id="register">
            <invocation/>
            <in>
                <field id="name"/>
            </in>
            <out>
                <field id="id"/>
            </out>
            <fail-out>
                <field mapping="#this.getMessage()"/>
            </fail-out>
        </operation>
    </operations>
</object>