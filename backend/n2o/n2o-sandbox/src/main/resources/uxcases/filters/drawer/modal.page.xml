<?xml version='1.0' encoding='UTF-8'?>
<page xmlns="http://n2oapp.net/framework/config/schema/page-4.0" name="Фильтры">
    <datasources>
        <parent-datasource id="ds1"/>
        <inherited-datasource id="modalDs"
                              source-datasource="ds1"
                              source-model="filter"/>
    </datasources>
    <regions>
        <form datasource="modalDs">
            <fields>
                <row>
                    <date-interval id="date" label="Дата подачи заявки"/>
                </row>
                <select id="region" label="Регион" query-id="region"/>
                <select id="department" label="Отделение" query-id="department"/>
                <select id="status" label="Статус" query-id="status"/>
                <set label="Заявитель">
                    <input-text id="fio" label="Фамилия Имя Отчество" default-value="{fio}"/>
                    <masked-input id="snils" label="СНИЛС" mask="999-999-999 99"/>
                </set>
            </fields>
        </form>
    </regions>
</page>
