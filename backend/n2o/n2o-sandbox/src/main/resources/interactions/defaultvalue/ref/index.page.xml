<?xml version='1.0' encoding='UTF-8'?>
<page xmlns="http://n2oapp.net/framework/config/schema/page-4.0"
      name="Значение по умолчанию через ссылку на данные">
    <datasources>
        <datasource id="ds"/>
    </datasources>
    <regions>
        <form id="persons" datasource="ds">
            <fields>
                <input-text id="id" default-value="123"/>
                <input-text id="name" default-value="text"/>
            </fields>
            <toolbar place="bottomLeft">
                <button label="Открыть">
                    <show-modal page-id="persons"/>
                </button>
            </toolbar>
        </form>
    </regions>
</page>