<?xml version='1.0' encoding='UTF-8'?>
<page xmlns="http://n2oapp.net/framework/config/schema/page-4.0"
      name="Модальная страница с прокинутыми значениями">
    <datasources>
        <parent-datasource id="parentDs"/>
        <parent-datasource id="form2Ds"/>
    </datasources>
    <regions>
        <form id="info">
            <fields>
                <input-text id="city" label="Значение из поля виджета, в котором кнопка открытия окна"
                            ref-datasource="parentDs" default-value="{city}"/>
                <input-text id="street" label="Значение из поля другого виджета"
                            ref-datasource="form2Ds" default-value="{street}"/>
                <input-text id="house" label="Значение вводимое только в модальном окне"/>
            </fields>
        </form>
    </regions>
</page>