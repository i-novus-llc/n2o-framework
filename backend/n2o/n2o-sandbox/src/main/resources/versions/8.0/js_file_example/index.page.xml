<?xml version='1.0' encoding='UTF-8'?>
<simple-page xmlns="http://n2oapp.net/framework/config/schema/page-4.0"
             name="JS выражение в отдельном файле">
    <form>
        <datasource object-id="test"/>
        <fields>
            <input-text id="price" label="Цена" domain="numeric"/>
            <input-text id="quantity" label="Количество" domain="numeric"/>
            <input-text id="total" label="Итого" domain="numeric" enabled="false">
                <dependencies>
                    <set-value on="price,quantity" file="js/calc.js"/>
                </dependencies>
            </input-text>
        </fields>
        <toolbar place="bottomRight">
            <button label="Сохранить" color="primary">
                <invoke operation-id="save"/>
            </button>
        </toolbar>
    </form>
</simple-page>